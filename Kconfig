# Zephyr 4.1 BT_ECC selects the ECC key-pair operations but omits the public
# key prerequisite enforced by the pinned NCS 3.1.1 Oberon core.
config TOTEM_NCS_BLE_ECC_PUBLIC_KEY_COMPAT
    bool
    default y
    depends on NRF_SECURITY && BT_ECC
    select PSA_WANT_KEY_TYPE_ECC_PUBLIC_KEY

menu "Totem ESB compatibility and benchmark"

config TOTEM_ESB_COMPAT
    bool "Apply the pinned Totem ESB compatibility patch"
    depends on ZMK_SPLIT_ESB
    default n
    help
      Applies the small compatibility layer for the exact ESB and Prospector
      revisions pinned in config/west.yml.

config TOTEM_ESB_PROSPECTOR
    bool "Enable Prospector ESB peer status integration"
    depends on TOTEM_ESB_COMPAT && ZMK_SPLIT_ROLE_CENTRAL
    default n

config TOTEM_ESB_V3
    bool "Enable authenticated/encrypted Totem ESB v3 transport"
    depends on TOTEM_ESB_COMPAT
    default n
    help
      Replaces the v2 CRC32 postfix with AES-128-CCM encryption and a
      BLE-sized 4-byte MIC. A two-nonce authenticated handshake establishes
      a fresh session before ZMK events or commands are accepted.

config TOTEM_ESB_V3_CI_TEST_KEYS
    bool "Use public disposable ESB v3 CI test keys"
    depends on TOTEM_ESB_V3
    default n
    help
      Enables keys that are public in this repository. Firmware built with
      this option is only for compile/protocol testing and is not secure.

config TOTEM_ESB_V3_LOCAL_KEY_HEX
    string "ESB v3 local peripheral link key (32 hex characters)"
    depends on TOTEM_ESB_V3 && !ZMK_SPLIT_ROLE_CENTRAL
    default "4d4f5d2cd993c6be0db2495606d229a1" if TOTEM_ESB_V3_CI_TEST_KEYS && SHIELD_TOTEM_ESB_LEFT
    default "ed812b6ff48a2e17328b623983cb776c" if TOTEM_ESB_V3_CI_TEST_KEYS && SHIELD_TOTEM_ESB_RIGHT
    default ""

config TOTEM_ESB_V3_LEFT_KEY_HEX
    string "ESB v3 dongle-to-left link key (32 hex characters)"
    depends on TOTEM_ESB_V3 && ZMK_SPLIT_ROLE_CENTRAL
    default "4d4f5d2cd993c6be0db2495606d229a1" if TOTEM_ESB_V3_CI_TEST_KEYS
    default ""

config TOTEM_ESB_V3_RIGHT_KEY_HEX
    string "ESB v3 dongle-to-right link key (32 hex characters)"
    depends on TOTEM_ESB_V3 && ZMK_SPLIT_ROLE_CENTRAL
    default "ed812b6ff48a2e17328b623983cb776c" if TOTEM_ESB_V3_CI_TEST_KEYS
    default ""

config TOTEM_ESB_V3_HANDSHAKE_INTERVAL_MS
    int "ESB v3 handshake probe interval in milliseconds"
    depends on TOTEM_ESB_V3
    default 2
    range 1 100

config TOTEM_ESB_V3_SESSION_OK_TIMEOUT_MS
    int "ESB v3 SESSION_OK wait timeout in milliseconds"
    depends on TOTEM_ESB_V3 && !ZMK_SPLIT_ROLE_CENTRAL
    default 2000
    range 250 30000
    help
      Starts a fresh HELLO with a new boot nonce if the peripheral remains
      in WAIT_SESSION_OK for this long. This recovers after the central has
      discarded a pending key during an extended RF outage.

config TOTEM_ESB_V3_PENDING_TIMEOUT_MS
    int "ESB v3 central pending-session timeout in milliseconds"
    depends on TOTEM_ESB_V3 && ZMK_SPLIT_ROLE_CENTRAL
    default 2000
    range 250 30000
    help
      Discards an unconfirmed central pending key after this interval. This
      prevents one replayed HELLO or RECOVERY from pinning the handshake
      forever while still keeping a MIC-failure reset transcript fixed
      during the bounded recovery window.

config TOTEM_ESB_V3_PRESESSION_EVENT_QUEUE_SIZE
    int "Events retained while an ESB v3 session is negotiated"
    depends on TOTEM_ESB_V3 && !ZMK_SPLIT_ROLE_CENTRAL
    default 32
    range 8 128

config TOTEM_ESB_HEARTBEAT_INTERVAL_MS
    int "Peripheral heartbeat interval in milliseconds"
    depends on TOTEM_ESB_COMPAT
    default 250
    range 50 5000

config TOTEM_ESB_PEER_TIMEOUT_MS
    int "Central peer timeout in milliseconds"
    depends on TOTEM_ESB_COMPAT && ZMK_SPLIT_ROLE_CENTRAL
    default 1500
    range 250 30000

config TOTEM_ESB_BENCHMARK
    bool "Enable ESB sequence/latency benchmark logging"
    depends on TOTEM_ESB_COMPAT
    default n

config TOTEM_ESB_BENCHMARK_PERIOD_US
    int "Synthetic benchmark packet period in microseconds"
    depends on TOTEM_ESB_BENCHMARK
    default 1000
    range 500 1000000

config TOTEM_ESB_BENCHMARK_ZERO_DEBOUNCE
    bool "Use zero debounce in a benchmark-only auxiliary shield"
    depends on TOTEM_ESB_BENCHMARK
    default n

endmenu
