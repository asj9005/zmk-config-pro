//                                                               ▀      █  █  █     █▄█
//                                                             ▀▀▀▀▀    █  █  █      ▀
//                                                                      ▀  ▀  ▀
//
// ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

#include <input/processors.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define Base        0
#define Mouse       1
#define Hold        2
#define Acc         3
#define Prec        4
#define Num         5
#define Fun         6
#define Asj         7
#define Start       8
#define Nav         9

/* --- Mouse speed scalers (instant ACC / PREC) --- */

&mmv_input_listener {
    /* default 1x */

    input-processors = <&zip_xy_scaler 2 1>;

    fast {
        layers = <Acc>;
        input-processors = <&zip_xy_scaler 5 1>; /* 3x speed */
    };

    slow {
        layers = <Prec>;
        input-processors = <&zip_xy_scaler 1 3>; /* 1/3x speed */
    };
};

&msc_input_listener {
    input-processors = <&zip_scroll_scaler 1 1>;

    fast {
        layers = <Acc>;
        input-processors = <&zip_scroll_scaler 3 1>;
    };

    slow {
        layers = <Prec>;
        input-processors = <&zip_scroll_scaler 1 3>;
    };
};

&mt {
    quick-tap-ms = <100>;
    global-quick-tap;
    flavor = "tap-preferred";
    tapping-term-ms = <170>;
};

&lt {
    tapping-term-ms = <240>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

&sk { quick-release; };

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <125>;
            global-quick-tap;
            bindings = <&sk>, <&kp>;
        };

        tapdance: tapdance {
            compatible = "zmk,behavior-tap-dance";
            label = "TAPDANCE";
            #binding-cells = <0>;
            bindings = <&mo 7>, <&kmswitch>;
        };

        question: question {
            compatible = "zmk,behavior-mod-morph";
            label = "QUESTION";
            bindings = <&kp EXCLAMATION>, <&kp QUESTION>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT|MOD_LSFT)>;
        };

        shiftsk: shiftsk {
            compatible = "zmk,behavior-sticky-key";
            label = "SHIFTSK";
            bindings = <&kp>;
            #binding-cells = <1>;
            release-after-ms = <1000>;
            quick-release;
            ignore-modifiers;
        };

        shiftmodmorph: shiftmodmorph {
            compatible = "zmk,behavior-mod-morph";
            label = "SHIFTMODMORPH";
            bindings = <&shiftsk RIGHT_SHIFT>, <&caps_word>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT)>;
        };

        shiftht: shiftht {
            compatible = "zmk,behavior-hold-tap";
            label = "SHIFTHT";
            bindings = <&kp>, <&shiftmodmorph>;

            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
        };

        bracketmod: bracketmod {
            compatible = "zmk,behavior-mod-morph";
            label = "BRACKETMOD";
            bindings = <&bracket>, <&bracket2>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT)>;
        };

        atlayerhmbe: atlayerhmbe {
            compatible = "zmk,behavior-hold-tap";
            label = "ATLAYERHMBE";
            bindings = <&atlayerhm>, <&atlayertab>;

            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <180>;
        };

        atlayerspeed: atlayerspeed {
            compatible = "zmk,behavior-hold-tap";
            label = "ATLAYERSPEED";
            bindings = <&mo>, <&atlayertab>;

            #binding-cells = <2>;
            tapping-term-ms = <180>;
            flavor = "tap-preferred";
        };

        numsymtog: numsymtog {
            compatible = "zmk,behavior-mod-morph";
            label = "NUMSYMTOG";
            bindings = <&to 6>, <&to 0>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT)>;
        };

        numsymtog2: numsymtog2 {
            compatible = "zmk,behavior-mod-morph";
            label = "NUMSYMTOG2";
            bindings = <&mo 6>, <&mo 0>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT)>;
        };

        numsymbtn: numsymbtn {
            compatible = "zmk,behavior-hold-tap";
            label = "NUMSYMBTN";
            bindings = <&numsymtog2>, <&numsymtog>;

            #binding-cells = <2>;
            tapping-term-ms = <180>;
            flavor = "tap-preferred";
        };

        nummmm: nummmm {
            compatible = "zmk,behavior-hold-tap";
            label = "NUMMMM";
            bindings = <&mo>, <&to>;

            #binding-cells = <2>;
            tapping-term-ms = <180>;
            flavor = "tap-preferred";
        };

        timemod: timemod {
            compatible = "zmk,behavior-mod-morph";
            label = "TIMEMOD";
            bindings = <&kp TILDE>, <&kp COLON>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT|MOD_LSFT)>;
        };

        tomolayer: tomolayer {
            compatible = "zmk,behavior-hold-tap";
            label = "TOMOLAYER";
            bindings = <&mo>, <&to>;

            #binding-cells = <2>;
            tapping-term-ms = <180>;
            flavor = "tap-preferred";
        };

        shiftdance: shiftdance {
            compatible = "zmk,behavior-tap-dance";
            label = "SHIFTDANCE";
            #binding-cells = <0>;
            bindings = <&kp LC(LS(LA(LG(M))))>, <&caps_word>;
        };

        swapper: swapper {
            compatible = "zmk,behavior-tri-state";
            label = "SWAPPER";
            #binding-cells = <0>;
            bindings = <&kt LALT>, <&kp TAB>, <&kt LALT>;

            ignored-key-positions = <2 3 7 16 17 18>;  // 키 위치를 숫자로 변환 필요
        };

        shift_lang1: shift_lang1 {
            compatible = "zmk,behavior-mod-morph";
            label = "SHIFT_LANG1";
            bindings = <&shiftsk RIGHT_SHIFT>, <&lang>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT)>;
        };

        shift_lang2: shift_lang2 {
            compatible = "zmk,behavior-hold-tap";
            label = "SHIFT_LANG2";
            bindings = <&lang_temp>, <&shift_lang1>;

            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <180>;
        };

        mo_caps: mo_caps {
            compatible = "zmk,behavior-hold-tap";
            label = "MO_CAPS";
            bindings = <&mo>, <&caps_word>;

            #binding-cells = <2>;
            tapping-term-ms = <180>;
            flavor = "balanced";
        };

        ps_di_mop: ps_di_mop {
            compatible = "zmk,behavior-mod-morph";
            label = "PS_DI_MOP";
            bindings = <&ps>, <&di>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT)>;
        };

        bs_del1: bs_del1 {
            compatible = "zmk,behavior-mod-morph";
            label = "BS_DEL1";
            bindings = <&kp BACKSPACE>, <&kp DELETE>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT)>;
        };

        bs_del2: bs_del2 {
            compatible = "zmk,behavior-mod-morph";
            label = "BS_DEL2";
            bindings = <&kp LC(BACKSPACE)>, <&kp LC(DELETE)>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT)>;
        };

        bs_del3: bs_del3 {
            compatible = "zmk,behavior-hold-tap";
            label = "BS_DEL3";
            bindings = <&bs_del2>, <&bs_del1>;

            #binding-cells = <2>;
            tapping-term-ms = <180>;
            flavor = "tap-preferred";
        };

        Jum: Jum {
            compatible = "zmk,behavior-mod-morph";
            label = "JUM";
            bindings = <&kp PERIOD>, <&kp COMMA>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT|MOD_LSFT)>;
        };

        Home1: Home1 {
            compatible = "zmk,behavior-mod-morph";
            label = "HOME1";
            bindings = <&kp HOME>, <&kp HOME>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL)>;
        };

        End1: End1 {
            compatible = "zmk,behavior-mod-morph";
            label = "END1";
            bindings = <&kp END>, <&kp END>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL)>;
        };

        HomeEnd1: HomeEnd1 {
            compatible = "zmk,behavior-mod-morph";
            label = "HOMEEND1";
            bindings = <&kp LC(HOME)>, <&kp LC(END)>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT|MOD_LSFT)>;
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_ctrl_x {
            bindings = <&kp LC(X)>;
            key-positions = <22 24>;
        };

        combo_ctrl_c {
            bindings = <&kp LC(C)>;
            key-positions = <22 23>;
        };

        combo_ctrl_v {
            bindings = <&kp LC(V)>;
            key-positions = <23 24>;
        };

        Enter_combo {
            bindings = <&kp ENTER>;
            key-positions = <13 12>;
        };

        Tab_combo {
            bindings = <&kp TAB>;
            key-positions = <11 12>;
        };

        altf4 {
            bindings = <&kp LA(F4)>;
            key-positions = <34 0>;
        };

        end {
            bindings = <&esccombo>;
            key-positions = <11 13>;
        };

        bracketcombo {
            bindings = <&bracketmod>;
            key-positions = <27 29>;
        };

        undo {
            bindings = <&kp LC(Z)>;
            key-positions = <21 22>;
        };

        reset_combo {
            bindings = <&sys_reset>;
            key-positions = <13 11 2>;
            layers = <7>;
        };

        jum_combo {
            bindings = <&kp PERIOD>;
            key-positions = <28 29>;
        };

        comma_combo {
            bindings = <&kp COMMA>;
            key-positions = <27 28>;
        };

        kmswitch_combo {
            bindings = <&kmswitch>;
            key-positions = <11 12 13>;
        };

        Ctrl_A_Combo {
            bindings = <&kp LC(A)>;
            key-positions = <22 23 24>;
        };

        LG_Combo {
            bindings = <&Skcb_Gui>;
            key-positions = <1 0>;
        };

        LS_Combo {
            bindings = <&Skcb_Shift>;
            key-positions = <2 3>;
        };

        LC_Combo {
            bindings = <&Skcb_Ctrl>;
            key-positions = <2 1>;
        };

        LA_Combo {
            bindings = <&Skcb_Alt>;
            key-positions = <3 1>;
        };

        RG_Combo {
            bindings = <&Skcb_Gui>;
            key-positions = <8 9>;
        };

        RS_Combo {
            bindings = <&Skcb_Shift>;
            key-positions = <7 6>;
        };

        RC_Combo {
            bindings = <&Skcb_Ctrl>;
            key-positions = <7 8>;
        };

        RA_Combo {
            bindings = <&Skcb_Alt>;
            key-positions = <6 8>;
        };
    };

    macros {
        ps: new_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap>,
                <&kp EXCL &kp T &kp J &kp D &kp W &kp N &kp S &kp N9 &kp N0 &kp N0 &kp N5>;

            label = "NEW_MACRO";
        };

        kmswitch: kmswitch {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap>,
                <&kp CAPS &kp SCROLLLOCK &kp KP_NUMLOCK>,
                <&macro_wait_time 80>,
                <&macro_tap>,
                <&kp CAPSLOCK &kp SCROLLLOCK &kp KP_NUMLOCK>;

            label = "kmswitch";
        };

        fancyzone: lang_toggle {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_GUI>,
                <&macro_wait_time 20>,
                <&macro_tap>,
                <&kp LEFT_ARROW>,
                <&macro_wait_time 20>,
                <&macro_release>,
                <&kp LEFT_GUI>;

            label = "LANG_TOGGLE";
        };

        lang_temp: lang_temp {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap>,
                <&kp LANGUAGE_1>,
                <&macro_pause_for_release>,
                <&macro_tap>,
                <&kp LANGUAGE_1>;

            label = "LANG_TEMP";
        };

        bracket: bracket {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap>,
                <&kp LEFT_PARENTHESIS &kp RIGHT_PARENTHESIS &kp LEFT_ARROW>;

            label = "BRACKET";
        };

        bracket2: bracket2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap>,
                <&kp LEFT_BRACKET &kp RIGHT_BRACKET &kp LEFT>;

            label = "BRACKET2";
        };

        atlayertab: atlayertab {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_tap>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER &to 0>;

            label = "atlayertab";
            wait-ms = <0>;
            tap-ms = <0>;
        };

        atlayerhm: atlayerhm {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_press>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>;

            label = "atlayerhm";
            wait-ms = <0>;
            tap-ms = <0>;
        };

        alttab: alttab {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT &kp TAB>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp TAB>;

            label = "ALTTAB";
            wait-ms = <0>;
            tap-ms = <0>;
        };

        esccombo: esccombo {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&to 0 &kp ESCAPE>;

            label = "ESCCOMBO";
        };

        mousefind: mousefind {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap>,
                <&kp RIGHT_CONTROL>,
                <&macro_wait_time 10>,
                <&kp RIGHT_CONTROL>;

            label = "MOUSEFIND";
        };

        lang: lang {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&kp LANGUAGE_1 &to 0>;

            label = "LANG";
            wait-ms = <0>;
            tap-ms = <0>;
        };

        di: di {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap>,
                <&kp A &kp S &kp J &kp N9 &kp N0 &kp N0 &kp N5>;

            label = "DI";
        };

        Skcb_Ctrl: Skcb_Ctrl {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&to 0 &sk LCTRL>;

            label = "SKCB_CTRL";
            wait-ms = <0>;
            tap-ms = <0>;
        };

        Skcb_Shift: Skcb_Shift {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&to 0 &sk LEFT_SHIFT>;

            label = "SKCB_SHIFT";
            wait-ms = <0>;
            tap-ms = <0>;
        };

        Skcb_Alt: Skcb_Alt {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&to 0 &sk LEFT_ALT>;

            label = "SKCB_ALT";
            wait-ms = <0>;
            tap-ms = <0>;
        };

        Skcb_Gui: Skcb_Gui {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&to 0 &sk LEFT_GUI>;

            label = "SKCB_GUI";
            wait-ms = <0>;
            tap-ms = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Base {
            display-name = "Base";
            bindings = <
       &kp LC(M)  &kp W  &kp E    &kp R        &kp T             &kp Y           &kp U             &kp I         &kp O  &kp PRINTSCREEN
       &kp A      &kp S  &lt 3 D  &lt 4 F      &kp G             &kp H           &kp J             &kp K         &kp L  &bs_del3 0 0
&sl 7  &kp Z      &kp X  &kp C    &kp V        &kp Q             &kp B           &kp N             &kp M         &kp P  &Jum             &shiftdance
                         &sl 8    &lt 9 SPACE  &tomolayer 2 1    &tomolayer 5 5  &shift_lang2 0 0  &mo_caps 6 0
            >;
        };

        Mouse {
            display-name = "Mouse";
            bindings = <
        &atlayertab LC(M)        &atlayertab W            &atlayertab E         &atlayertab R              &atlayertab T    &mkp MB2         &mkp MB4        &mmv MOVE_UP    &mkp MB5         &kp LS(LA(LC(LG(F))))
        &atlayertab A            &atlayertab S            &atlayerspeed 3 D     &atlayerspeed 4 F          &atlayertab G    &msc SCRL_LEFT   &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &trans
&trans  &atlayerhmbe LEFT_GUI Z  &atlayerhmbe LEFT_ALT X  &atlayerhmbe LCTRL C  &atlayerhmbe LEFT_SHIFT V  &atlayertab Q    &msc SCRL_RIGHT  &msc SCRL_UP    &msc SCRL_DOWN  &mkp MB3         &ps_di_mop             &trans
                                                          &trans                &trans                     &mkp MB1         &trans           &trans          &trans
            >;
        };

        Hold {
            bindings = <
        &kp LC(LS(Q))    &trans  &mo 3              &kp LC(TAB)    &fancyzone          &mkp MB2         &mkp MB4        &mmv MOVE_UP    &mkp MB5         &kp LS(LA(LC(LG(F))))
        &kp PRINTSCREEN  &trans  &trans             &trans         &kp LG(UP_ARROW)    &msc SCRL_LEFT   &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &trans
&trans  &trans           &trans  &kp LC(LS(LG(T)))  &kp LS(LG(S))  &kp LG(LS(LEFT))    &msc SCRL_RIGHT  &msc SCRL_UP    &msc SCRL_DOWN  &mkp MB3         &ps_di_mop             &trans
                                 &trans             &trans         &mkp MB1            &trans           &trans          &trans
            >;

            label = "Hold";
        };

        Acc {
            bindings = <
        &trans  &kp LC(W)  &trans  &kp LC(N)      &kp LC(T)    &trans  &trans  &trans  &trans  &trans
        &trans  &kp LC(S)  &trans  &kp LC(ENTER)  &trans       &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans     &trans  &kp LC(TAB)    &trans       &trans  &trans  &trans  &trans  &trans  &trans
                           &trans  &trans         &trans       &trans  &trans  &trans
            >;

            label = "Acc";
        };

        Prec {
            bindings = <
        &trans  &trans  &trans         &trans  &trans    &trans  &trans  &trans  &trans  &trans
        &trans  &trans  &kp LS(ENTER)  &trans  &trans    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &kp LS(TAB)    &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans         &trans  &trans    &trans  &trans  &trans
            >;

            label = "Prec";
        };

        Num {
            bindings = <
        &atlayertab LC(M)        &atlayertab W            &atlayertab E         &atlayertab R              &atlayertab T    &kp MINUS  &kp N7  &kp N8       &kp N9  &timemod
        &atlayertab A            &atlayertab S            &atlayerspeed 3 D     &atlayerspeed 4 F          &atlayertab G    &kp N0     &kp N4  &kp N5       &kp N6  &trans
&trans  &atlayerhmbe LEFT_GUI Z  &atlayerhmbe LEFT_ALT X  &atlayerhmbe LCTRL C  &atlayerhmbe LEFT_SHIFT V  &atlayertab Q    &kp EQUAL  &kp N1  &kp N2       &kp N3  &trans    &trans
                                                          &trans                &trans                     &trans           &trans     &trans  &lt 6 ENTER
            >;

            label = "Num";
        };

        Fun {
            bindings = <
        &kp F12  &kp F7  &kp F8  &kp F9  &kp LC(F10)       &trans  &kp LS(COMMA)  &kp LS(PERIOD)  &trans    &trans
        &kp F11  &kp F4  &kp F5  &kp F6  &trans            &trans  &kp LSHFT      &kp LCTRL       &kp LALT  &kp LGUI
&trans  &kp F10  &kp F1  &kp F2  &kp F3  &kp LANGUAGE_2    &trans  &trans         &trans          &trans    &trans    &trans
                         &trans  &trans  &trans            &trans  &trans         &trans
            >;

            label = "Fun";
        };

        Asj {
            bindings = <
        &sys_reset  &kp F23  &kp F24  &trans  &studio_unlock    &trans  &trans  &trans  &trans  &trans
        &trans      &trans   &trans   &trans  &trans            &trans  &trans  &trans  &trans  &trans
&trans  &trans      &trans   &trans   &trans  &trans            &trans  &trans  &trans  &trans  &trans  &trans
                             &trans   &trans  &kmswitch         &trans  &trans  &trans
            >;
        };

        Start {
            bindings = <
        &trans  &kp LG(LS(N1))  &kp LG(LS(N2))  &kp LG(LS(N3))  &kp LG(LS(N4))    &kp LG(LS(N5))  &kp LG(LS(N6))  &kp LG(LS(N7))  &kp LG(LS(N8))  &kp LG(LS(N9))
        &trans  &trans          &trans          &trans          &trans            &trans          &trans          &trans          &trans          &trans
&trans  &trans  &trans          &trans          &trans          &trans            &trans          &trans          &trans          &trans          &trans          &trans
                                &trans          &trans          &trans            &trans          &trans          &trans
            >;
        };

        Nav {
            bindings = <
        &kp LC(INS)   &kp LC(MINUS)  &kp LS(LC(Q))  &swapper           &fancyzone                &trans     &Home1          &kp UP_ARROW   &End1            &trans
        &kp LGUI      &kp LC(SPACE)  &kp LC(LS(Q))  &kp LA(LG(SPACE))  &kp LG(UP_ARROW)          &trans     &kp LEFT_ARROW  &kp DOWN       &kp RIGHT_ARROW  &trans
&trans  &kp LEFT_WIN  &kp LEFT_ALT   &kp LCTRL      &kp LSHIFT         &kp LS(LG(LEFT_ARROW))    &kp LC(Z)  &kp PAGE_UP     &kp PAGE_DOWN  &HomeEnd1        &trans  &trans
                                     &trans         &trans             &trans                    &kp ENTER  &trans          &trans
            >;

            label = "Nav";
        };
    };
};
