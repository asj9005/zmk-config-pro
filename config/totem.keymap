            compatible = "zmk,behavior-mod-morph";
            label = "SIGN_MOD5";
            bindings = <&kp ASTERISK>, <&kp GRAVE>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT)>;
        };

        Sign_Mod6: Sign_Mod6 {
            compatible = "zmk,behavior-mod-morph";
            label = "SIGN_MOD6";
