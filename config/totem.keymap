            label = "MBK_MOD1";
            bindings = <&mkp MB4>, <&kp LA(UP_ARROW)>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT)>;
        };

        MBK_Mod2: MBK_Mod2 {
            compatible = "zmk,behavior-mod-morph";
            label = "MBK_MOD2";
            bindings = <&mkp MB5>, <&kp LA(LC(LG(LS(F))))>;

