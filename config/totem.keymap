    combos {
        compatible = "zmk,combos";

        combo_ctrl_x {
            bindings = <&kp LC(X)>;
            key-positions = <22 24>;
        };

        combo_ctrl_c {
            bindings = <&kp LC(C)>;
            key-positions = <22 23>;
        };

        combo_ctrl_v {
            bindings = <&kp LC(V)>;
            key-positions = <23 24>;
        };

        altf4 {
            bindings = <&kp LA(F4)>;
            key-positions = <34 0>;
        };

        end {
            bindings = <&esccombo>;
            key-positions = <3 1 2>;
        };

        bracketcombo {
            bindings = <&bracketmod>;
            key-positions = <27 29>;
        };

        undo {
            bindings = <&kp LC(Z)>;
            key-positions = <21 22>;
        };

        reset_combo {
            bindings = <&sys_reset>;
            key-positions = <13 11 2>;
            layers = <6>;
        };

        Arrow_combo {
            bindings = <&Arrow_Mod>;
            key-positions = <30 27>;
        };

        Colon_combo {
            bindings = <&Colon1>;
            key-positions = <28 29>;
        };

        kmswitch_combo {
            bindings = <&kmswitch>;
            key-positions = <3 1>;
        };

        Ctrl_A_Combo {
            bindings = <&kp LC(A)>;
            key-positions = <22 23 24>;
        };

        LG_Combo {
            bindings = <&Gui_Combo LEFT_GUI 0>;
            key-positions = <11 10>;
        };

        LS_Combo {
            bindings = <&Shift_Combo LEFT_SHIFT 0>;
            key-positions = <12 11>;
        };

        LC_Combo {
            bindings = <&Ctrl_Combo LCTRL 0>;
            key-positions = <12 13>;
        };

        LA_Combo {
            bindings = <&Alt_Combo LEFT_ALT 0>;
            key-positions = <13 11>;
        };

        RG_Combo {
            bindings = <&Gui_Combo LEFT_GUI 0>;
            key-positions = <18 19>;
        };

        RS_Combo {
            bindings = <&Shift_Combo LEFT_SHIFT 0>;
            key-positions = <17 18>;
            layers = <0 5 6 7 4>;
        };

        RC_Combo {
            bindings = <&Ctrl_Combo LCTRL 0>;
            key-positions = <17 16>;
            layers = <0 4 5 6 7>;
        };

        RA_Combo {
            bindings = <&Alt_Combo LEFT_ALT 0>;
            key-positions = <18 16>;
            layers = <0 5 6 7 4>;
        };

        LE_Combo {
            bindings = <&kp ENTER>;
            key-positions = <2 3>;
        };

        LT_Combo {
            bindings = <&kp TAB>;
            key-positions = <2 1>;
        };

        RE_Combo {
            bindings = <&kp ENTER>;
            key-positions = <6 7>;
        };

        RT_Combo {
            bindings = <&kp TAB>;
            key-positions = <7 8>;
        };

        layer0 {
            bindings = <&to 0>;
            key-positions = <6 8 7>;
        };

        LCS_Combo {
            bindings = <&CS_Combo 0 0>;
            key-positions = <11 12 13>;
        };

        LCA_Combo {
            bindings = <&CA_Combo 0 0>;
            key-positions = <12 10 13>;
        };

        LSA_Combo {
            bindings = <&SA_Combo 0 0>;
            key-positions = <11 10 12>;
        };

        RCS_Combo {
            bindings = <&CS_Combo 0 0>;
            key-positions = <16 17 18>;
        };

        RCA_Combo {
            bindings = <&CA_Combo 0 0>;
            key-positions = <17 19 16>;
        };

        RSA_Combo {
            bindings = <&SA_Combo 0 0>;
            key-positions = <19 18 17>;
        };

        Comma2 {
            bindings = <&Comma1>;
            key-positions = <27 28>;
        };

        Printscreen_Combo {
            bindings = <&Ps_Mod>;
            key-positions = <16 7 18>;
        };

        Sign_Combo1 {
            bindings = <&Sign_Mod1>;
            key-positions = <2 11>;
        };

        Sign_Combo2 {
            bindings = <&Sign_Mod2>;
            key-positions = <13 2>;
        };

        Sign_Combo3 {
            bindings = <&Sign_Mod3>;
            key-positions = <12 22>;
        };

        Sign_Combo4 {
            bindings = <&Sign_Mod4>;
            key-positions = <12 24>;
        };
    };

    macros {
        ps: ps {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap>,
                <&kp EXCL &kp T &kp J &kp D &kp W &kp N &kp S &kp N9 &kp N0 &kp N0 &kp N5>;

            label = "ps";
        };

        kmswitch: kmswitch {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap>,
                <&kp CAPS &kp SCROLLLOCK &kp KP_NUMLOCK>,
                <&macro_wait_time 80>,
                <&macro_tap>,
                <&kp CAPSLOCK &kp SCROLLLOCK &kp KP_NUMLOCK>;

            label = "kmswitch";
        };

        fancyzone: lang_toggle {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_GUI>,
                <&macro_wait_time 20>,
                <&macro_tap>,
                <&kp LEFT_ARROW>,
                <&macro_wait_time 20>,
                <&macro_release>,
                <&kp LEFT_GUI>;

            label = "LANG_TOGGLE";
        };

        lang_temp: lang_temp {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap>,
                <&to 0 &kp LANGUAGE_1>,
                <&macro_pause_for_release>,
                <&macro_tap>,
                <&kp LANGUAGE_1>;

            label = "LANG_TEMP";
            wait-ms = <0>;
            tap-ms = <0>;
        };

        bracket: bracket {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap>,
                <&kp LEFT_PARENTHESIS &kp RIGHT_PARENTHESIS &kp LEFT_ARROW>;

            label = "BRACKET";
        };

        bracket2: bracket2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap>,
                <&kp LEFT_BRACKET &kp RIGHT_BRACKET &kp LEFT>;

            label = "BRACKET2";
        };

        atlayertab: atlayertab {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_tap>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER &to 0>;

            label = "atlayertab";
            wait-ms = <0>;
            tap-ms = <0>;
        };

        atlayerhm: atlayerhm {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_press>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>;

            label = "atlayerhm";
            wait-ms = <0>;
            tap-ms = <0>;
        };

        alttab: alttab {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT &kp TAB>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp TAB>;

            label = "ALTTAB";
            wait-ms = <0>;
            tap-ms = <0>;
        };

        esccombo: esccombo {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&to 0 &kp ESCAPE>;

            label = "ESCCOMBO";
        };

        mousefind: mousefind {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap>,
                <&kp RIGHT_CONTROL>,
                <&macro_wait_time 10>,
                <&kp RIGHT_CONTROL>;

            label = "MOUSEFIND";
        };

        lang: lang {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&to 0 &kp LANGUAGE_1>;

            label = "LANG";
            wait-ms = <0>;
            tap-ms = <0>;
        };

        di: di {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap>,
                <&kp A &kp S &kp J &kp N9 &kp N0 &kp N0 &kp N5>;

            label = "DI";
        };

        Skcb_Ctrl: Skcb_Ctrl {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&to 0 &sk LCTRL>;

            label = "SKCB_CTRL";
            wait-ms = <0>;
            tap-ms = <0>;
        };

        Skcb_Shift: Skcb_Shift {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&to 0 &sk LEFT_SHIFT>;

            label = "SKCB_SHIFT";
            wait-ms = <0>;
            tap-ms = <0>;
        };

        Skcb_Alt: Skcb_Alt {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&to 0 &sk LEFT_ALT>;

            label = "SKCB_ALT";
            wait-ms = <0>;
            tap-ms = <0>;
        };

        Skcb_Gui: Skcb_Gui {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&to 0 &sk LEFT_GUI>;

            label = "SKCB_GUI";
            wait-ms = <0>;
            tap-ms = <0>;
        };

        Arrow_Left: Arrow_Left {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&kp LT &kp MINUS>;

            label = "ARROW_LEFT";
        };

        Arrow_Right: Arrow_Right {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&kp MINUS &kp GT>;

            label = "ARROW_RIGHT";
        };

        Skcb_CS: Skcb_CS {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&to 0 &sk LCTRL &sk LEFT_SHIFT>;

            label = "SKCB_CS";
            wait-ms = <0>;
            tap-ms = <0>;
        };

        Skcb_CSH: Skcb_CSH {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&kp LCTRL &kp LEFT_SHIFT>;

            label = "SKCB_CSH";
            wait-ms = <0>;
            tap-ms = <0>;
        };

        Skcb_CA: Skcb_CA {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&to 0 &sk LCTRL &sk LEFT_ALT>;

            label = "SKCB_CA";
            wait-ms = <0>;
            tap-ms = <0>;
        };

        Skcb_CAH: Skcb_CAH {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&kp LCTRL &kp LEFT_ALT>;

            label = "SKCB_CAH";
            wait-ms = <0>;
            tap-ms = <0>;
        };

        Skcb_SA: Skcb_SA {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&to 0 &sk LEFT_SHIFT &sk LEFT_ALT>;

            label = "SKCB_SA";
            wait-ms = <0>;
            tap-ms = <0>;
        };

        Skcb_SAH: Skcb_SAH {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&kp LEFT_SHIFT &kp LEFT_ALT>;

            label = "SKCB_SAH";
            wait-ms = <0>;
            tap-ms = <0>;
        };

        hangul_table: hangul_table {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_tap>,
                <&kp N &kp T>,
                <&macro_release>,
                <&kp LCTRL>;

            label = "HANGUL_TABLE";
            wait-ms = <0>;
            tap-ms = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Base {
            display-name = "Base";
            bindings = <
       &kp LC(M)  &kp W            &kp E            &kp R            &kp T             &kp Y           &kp U         &kp I         &kp O  &kp SINGLE_QUOTE
       &kp A      &Sign_layer 9 S  &Sign_layer 2 D  &Sign_layer 3 F  &kp G             &kp H           &kp J         &kp K         &kp L  &bs_del3 0 0
&sl 6  &kp Z      &kp X            &kp C            &kp V            &kp Q             &kp B           &kp N         &kp M         &kp P  &Jum              &shiftdance
                                   &sl 7            &lt 8 SPACE      &tomolayer 1 1    &tomolayer 4 4  &lang_shift3  &mo_caps 5 0
            >;
        };

        Mouse {
            display-name = "Mouse";
            bindings = <
        &atlayertab LC(M)  &atlayertab W      &atlayertab E      &atlayertab R      &atlayertab T    &mkp MB2         &MBK_Mod1       &mmv MOVE_UP    &MBK_Mod2        &trans
        &atlayertab A      &atlayerspeed 9 S  &atlayerspeed 2 D  &atlayerspeed 3 F  &atlayertab G    &msc SCRL_LEFT   &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &trans
&trans  &atlayertab Z      &atlayertab X      &atlayertab C      &atlayertab V      &atlayertab Q    &msc SCRL_RIGHT  &msc SCRL_UP    &msc SCRL_DOWN  &MBK_Mod         &trans  &trans
                                              &trans             &trans             &mkp MB1         &trans           &trans          &trans
            >;
        };

        Acc {
            bindings = <
        &trans       &kp LG(E)    &trans  &di         &kp LA(F21)    &trans  &trans  &trans  &trans  &trans
        &kp LC(F21)  &kp LG(D)    &trans  &trans      &kp LA(F22)    &trans  &trans  &trans  &trans  &trans
&trans  &trans       &key_repeat  &trans  &ps_di_mop  &kp LA(F23)    &trans  &trans  &trans  &trans  &trans  &trans
                                  &trans  &trans      &trans         &trans  &trans  &trans
            >;

            label = "Acc";
        };

        Prec {
            bindings = <
        &trans  &kp LC(F22)     &kp LC(F23)  &trans  &trans    &trans  &trans  &trans  &trans  &trans
        &trans  &kp LC(F10)     &trans       &trans  &trans    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &kp LANGUAGE_2  &trans       &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                                &trans       &trans  &trans    &trans  &trans  &trans
            >;

            label = "Prec";
        };

        Num {
            bindings = <
        &atlayertab LC(M)  &atlayertab W      &atlayertab E      &atlayertab R      &atlayertab T    &kp MINUS  &kp N7  &kp N8       &kp N9  &trans
        &atlayertab A      &atlayerspeed 9 S  &atlayerspeed 2 D  &atlayerspeed 3 F  &atlayertab G    &kp N0     &kp N4  &kp N5       &kp N6  &trans
&trans  &atlayertab Z      &atlayertab X      &atlayertab C      &atlayertab V      &atlayertab Q    &kp EQUAL  &kp N1  &kp N2       &kp N3  &trans  &trans
                                              &trans             &trans             &trans           &trans     &trans  &lt 5 ENTER
            >;

            label = "Num";
        };

        Fun {
            bindings = <
        &kp F12  &kp F7  &kp F8  &kp F9  &kp LC(F10)       &trans  &kp LS(COMMA)  &kp LS(PERIOD)  &trans    &trans
        &kp F11  &kp F4  &kp F5  &kp F6  &trans            &trans  &kp LSHFT      &kp LCTRL       &kp LALT  &kp LGUI
&trans  &kp F10  &kp F1  &kp F2  &kp F3  &kp LANGUAGE_2    &trans  &trans         &trans          &trans    &trans    &trans
                         &trans  &trans  &trans            &trans  &trans         &trans
            >;

            label = "Fun";
        };

        Asj {
            bindings = <
        &sys_reset  &kp F23  &kp F24  &trans  &studio_unlock    &trans  &trans  &trans  &trans  &trans
        &trans      &kp F21  &kp F22  &trans  &trans            &trans  &trans  &trans  &trans  &trans
&trans  &trans      &trans   &trans   &trans  &trans            &trans  &trans  &trans  &trans  &trans  &sys_reset
                             &trans   &trans  &kmswitch         &trans  &trans  &trans
            >;
        };

        Start {
            bindings = <
        &trans  &kp LG(LS(N1))  &kp LG(LS(N2))  &kp LG(LS(N3))  &kp LG(LS(N4))    &kp LG(LS(N5))  &kp LG(LS(N6))  &kp LG(LS(N7))  &kp LG(LS(N8))  &kp LG(LS(N9))
        &trans  &trans          &trans          &trans          &trans            &trans          &trans          &trans          &trans          &trans
&trans  &trans  &trans          &trans          &trans          &trans            &trans          &trans          &trans          &trans          &trans          &trans
                                &trans          &trans          &trans            &trans          &trans          &trans
            >;
        };

        Nav {
            bindings = <
        &trans        &kp LC(LS(TAB))  &kp LC(TAB)       &swapper           &fancyzone                &kp LS(UP_ARROW)  &Home1          &kp UP_ARROW   &End1            &trans
        &kp LS(HOME)  &kp LC(SPACE)    &kp LC(LS(Q))     &kp LA(LG(SPACE))  &kp LG(UP_ARROW)          &kp LS(DOWN)      &kp LEFT_ARROW  &kp DOWN       &kp RIGHT_ARROW  &trans
&trans  &kp LS(END)   &kp LC(INS)      &kp LC(KP_MINUS)  &kp LC(KP_PLUS)    &kp LS(LG(LEFT_ARROW))    &kp LC(Z)         &kp PAGE_UP     &kp PAGE_DOWN  &HomeEnd1        &trans  &trans
                                       &trans            &trans             &trans                    &kp ENTER         &trans          &trans
            >;

            label = "Nav";
        };

        Han {
            bindings = <
        &trans  &trans  &kp LA(LS(R))  &kp LA(LS(E))  &trans           &kp AT_SIGN     &kp ASTERISK  &kp PLUS       &kp SLASH    &kp NON_US_BACKSLASH
        &trans  &trans  &kp LA(LS(N))  &kp LA(LS(W))  &hangul_table    &kp UNDERSCORE  &kp MINUS     &kp TILDE      &kp PERCENT  &kp DOLLAR
&trans  &trans  &trans  &kp LA(LS(A))  &kp LA(LS(Z))  &trans           &kp EQUAL       &kp HASH      &kp AMPERSAND  &kp CARET    &kp PIPE              &kp GRAVE
                        &trans         &trans         &trans           &trans          &trans        &trans
            >;
        };
    };
};
