        swapper: swapper {
            compatible = "zmk,behavior-tri-state";
            label = "SWAPPER";
            #binding-cells = <0>;
            bindings = <&kt LALT>, <&kp TAB>, <&kt LALT>;

            ignored-key-positions = <2 3 7 16 17 18>;  // 키 위치를 숫자로 변환 필요
        };

        mo_caps: mo_caps {
            compatible = "zmk,behavior-hold-tap";
            label = "MO_CAPS";
            bindings = <&mo>, <&caps_word>;

            #binding-cells = <2>;
            tapping-term-ms = <180>;
            flavor = "balanced";
        };

        ps_di_mop: ps_di_mop {
            compatible = "zmk,behavior-mod-morph";
            label = "PS_DI_MOP";
            bindings = <&ps>, <&di>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT)>;
