    macros {
        ps: ps {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap>,
                <&kp EXCL &kp T &kp J &kp D &kp W &kp N &kp S &kp N9 &kp N0 &kp N0 &kp N5>;

            label = "ps";
        };

        kmswitch: kmswitch {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap>,
                <&kp CAPS &kp SCROLLLOCK &kp KP_NUMLOCK>,
                <&macro_wait_time 80>,
                <&macro_tap>,
                <&kp CAPSLOCK &kp SCROLLLOCK &kp KP_NUMLOCK>;

            label = "kmswitch";
        };

        fancyzone: lang_toggle {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_GUI>,
                <&macro_wait_time 20>,
                <&macro_tap>,
                <&kp LEFT_ARROW>,
                <&macro_wait_time 20>,
                <&macro_release>,
                <&kp LEFT_GUI>;

            label = "LANG_TOGGLE";
        };

        lang_temp: lang_temp {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap>,
                <&to 0 &kp LANGUAGE_1>,
                <&macro_pause_for_release>,
                <&macro_tap>,
                <&kp LANGUAGE_1>;

            label = "LANG_TEMP";
            wait-ms = <0>;
            tap-ms = <0>;
        };

        bracket: bracket {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap>,
                <&kp LEFT_PARENTHESIS &kp RIGHT_PARENTHESIS &kp LEFT_ARROW>;

            label = "BRACKET";
        };

        bracket2: bracket2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap>,
                <&kp LEFT_BRACKET &kp RIGHT_BRACKET &kp LEFT>;

            label = "BRACKET2";
        };

        atlayertab: atlayertab {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_tap>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER &to 0>;

            label = "atlayertab";
            wait-ms = <0>;
            tap-ms = <0>;
        };

        atlayerhm: atlayerhm {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_press>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>;

            label = "atlayerhm";
            wait-ms = <0>;
            tap-ms = <0>;
        };

        alttab: alttab {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT &kp TAB>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp TAB>;

            label = "ALTTAB";
            wait-ms = <0>;
            tap-ms = <0>;
        };

        esccombo: esccombo {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&to 0 &kp ESCAPE>;

            label = "ESCCOMBO";
        };

        mousefind: mousefind {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap>,
                <&kp RIGHT_CONTROL>,
                <&macro_wait_time 10>,
                <&kp RIGHT_CONTROL>;

            label = "MOUSEFIND";
        };

        lang: lang {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&to 0 &kp LANGUAGE_1>;

            label = "LANG";
            wait-ms = <0>;
            tap-ms = <0>;
        };

        di: di {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap>,
                <&kp A &kp S &kp J &kp N9 &kp N0 &kp N0 &kp N5>;

            label = "DI";
        };

        Skcb_Ctrl: Skcb_Ctrl {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&to 0 &sk LCTRL>;

            label = "SKCB_CTRL";
            wait-ms = <0>;
            tap-ms = <0>;
        };

        Skcb_Shift: Skcb_Shift {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&to 0 &sk LEFT_SHIFT>;

            label = "SKCB_SHIFT";
            wait-ms = <0>;
            tap-ms = <0>;
        };

        Skcb_Alt: Skcb_Alt {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&to 0 &sk LEFT_ALT>;

            label = "SKCB_ALT";
            wait-ms = <0>;
            tap-ms = <0>;
        };

        Skcb_Gui: Skcb_Gui {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&to 0 &sk LEFT_GUI>;

            label = "SKCB_GUI";
            wait-ms = <0>;
            tap-ms = <0>;
        };

        Arrow_Left: Arrow_Left {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&kp LT &kp MINUS>;

            label = "ARROW_LEFT";
        };

        Arrow_Right: Arrow_Right {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&kp MINUS &kp GT>;

            label = "ARROW_RIGHT";
        };

        Skcb_CS: Skcb_CS {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&to 0 &sk LCTRL &sk LEFT_SHIFT>;

            label = "SKCB_CS";
            wait-ms = <0>;
            tap-ms = <0>;
        };

        Skcb_CSH: Skcb_CSH {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL &kp LEFT_SHIFT>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp LCTRL &kp LEFT_SHIFT>;

            label = "SKCB_CSH";
            wait-ms = <0>;
            tap-ms = <0>;
        };

        Skcb_CA: Skcb_CA {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&to 0 &sk LCTRL &sk LEFT_ALT>;

            label = "SKCB_CA";
            wait-ms = <0>;
            tap-ms = <0>;
        };

        Skcb_CAH: Skcb_CAH {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL &kp LEFT_ALT>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp LCTRL &kp LEFT_ALT>;

            label = "SKCB_CAH";
            wait-ms = <0>;
            tap-ms = <0>;
        };

        Skcb_SA: Skcb_SA {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&to 0 &sk LEFT_SHIFT &sk LEFT_ALT>;

            label = "SKCB_SA";
            wait-ms = <0>;
            tap-ms = <0>;
        };

        Skcb_SAH: Skcb_SAH {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_SHIFT &kp LEFT_ALT>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp LEFT_SHIFT &kp LEFT_ALT>;

            label = "SKCB_SAH";
            wait-ms = <0>;
            tap-ms = <0>;
        };

        hangul_table: hangul_table {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_tap>,
                <&kp N &kp T>,
                <&macro_release>,
                <&kp LCTRL>;

            label = "HANGUL_TABLE";
            wait-ms = <0>;
            tap-ms = <0>;
        };

        hangul_mail: hangul_mail {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_tap>,
                <&kp K &kp M>,
                <&macro_release>,
                <&kp LCTRL>;

            label = "HANGUL_MAIL";
            wait-ms = <0>;
            tap-ms = <0>;
        };

        Nav_CS: Nav_CS {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&sk LCTRL &sk LEFT_SHIFT>;

            label = "NAV_CS";
            wait-ms = <0>;
            tap-ms = <0>;
        };

        Nav_CA: Nav_CA {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&sk LCTRL &sk LEFT_ALT>;

            label = "NAV_CA";
            wait-ms = <0>;
            tap-ms = <0>;
        };

        Nav_SA: Nav_SA {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&sk LEFT_SHIFT &sk LEFT_ALT>;

            label = "NAV_SA";
            wait-ms = <0>;
            tap-ms = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Base {
            display-name = "Base";
            bindings = <
       &kp LC(M)  &kp W            &kp E            &kp R            &kp T             &kp Y            &kp U         &kp I         &kp O  &tide_mod
       &kp A      &Sign_layer 9 S  &Sign_layer 2 D  &Sign_layer 3 F  &kp G             &kp H            &kp J         &kp K         &kp L  &bs_del1
&sl 6  &kp Z      &kp X            &kp C            &kp V            &kp Q             &kp B            &kp N         &kp M         &kp P  &Jum       &shiftdance
                                   &sl 7            &lt 8 SPACE      &tomolayer 1 1    &tomolayer 10 4  &lang_shift3  &mo_caps 5 0
            >;
        };

        Mouse {
            display-name = "Mouse";
            bindings = <
        &atlayertab LC(M)  &atlayertab W      &atlayertab E      &atlayertab R      &atlayertab T    &mkp MB2         &MBK_Mod1       &mmv MOVE_UP    &MBK_Mod2        &trans
        &atlayertab A      &atlayerspeed 9 S  &atlayerspeed 2 D  &atlayerspeed 3 F  &atlayertab G    &msc SCRL_LEFT   &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &trans
&trans  &atlayertab Z      &atlayertab X      &atlayertab C      &atlayertab V      &atlayertab Q    &msc SCRL_RIGHT  &msc SCRL_UP    &msc SCRL_DOWN  &MBK_Mod         &trans  &trans
                                              &trans             &trans             &mkp MB1         &trans           &trans          &trans
            >;
        };

        Acc {
            bindings = <
        &trans           &kp LC(LS(F13))  &trans  &kp LC(LS(F15))  &trans    &trans  &trans  &trans  &trans  &trans
        &kp LC(LS(F14))  &kp LG(D)        &trans  &trans           &trans    &trans  &trans  &trans  &trans  &trans
&trans  &trans           &kp LG(E)        &trans  &kp LC(LS(F16))  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                                          &trans  &trans           &trans    &trans  &trans  &trans
            >;

            label = "Acc";
        };

        Prec {
            bindings = <
        &trans           &di              &kp LC(LS(F18))  &trans  &trans    &trans  &trans  &trans  &trans  &trans
        &kp LC(LS(F19))  &ps_di_mop       &trans           &trans  &trans    &trans  &trans  &trans  &trans  &trans
&trans  &kp LC(LS(F21))  &kp LC(LS(F17))  &kp LC(LS(F20))  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                                          &trans           &trans  &trans    &trans  &trans  &trans
            >;

            label = "Prec";
        };

        Num {
            bindings = <
        &atlayertab LC(M)  &atlayertab W      &atlayertab E      &atlayertab R      &atlayertab T    &kp MINUS  &kp N7  &kp N8  &kp N9  &trans
        &atlayertab A      &atlayerspeed 9 S  &atlayerspeed 2 D  &atlayerspeed 3 F  &atlayertab G    &kp N0     &kp N4  &kp N5  &kp N6  &trans
&trans  &atlayertab Z      &atlayertab X      &atlayertab C      &atlayertab V      &atlayertab Q    &kp EQUAL  &kp N1  &kp N2  &kp N3  &trans  &trans
                                              &trans             &trans             &trans           &trans     &trans  &trans
            >;

            label = "Num";
        };

        Fun {
            bindings = <
        &trans  &kp F7  &kp F8  &kp F9  &kp F12    &trans  &kp LS(COMMA)  &kp LS(PERIOD)  &trans    &trans
        &trans  &kp F4  &kp F5  &kp F6  &kp F11    &trans  &kp LSHFT      &kp LCTRL       &kp LALT  &kp LGUI
&trans  &trans  &kp F1  &kp F2  &kp F3  &kp F10    &trans  &trans         &trans          &trans    &trans    &trans
                        &trans  &trans  &trans     &trans  &trans         &trans
            >;

            label = "Fun";
        };

        Asj {
            bindings = <
        &sys_reset  &kp F23          &kp F24          &trans           &studio_unlock    &trans  &trans  &trans  &trans  &trans
        &trans      &kp LC(LA(F13))  &kp LC(LA(F14))  &kp LC(LA(F16))  &kp LG(L)         &trans  &trans  &trans  &trans  &trans
&trans  &trans      &trans           &kp C_PIP        &kp C_POWER      &kp K_SLEEP       &trans  &trans  &trans  &trans  &trans  &sys_reset
                                     &trans           &trans           &kmswitch         &trans  &trans  &trans
            >;
        };

        Start {
            bindings = <
        &trans  &kp LG(LS(N1))  &kp LG(LS(N2))  &kp LG(LS(N3))  &kp LG(LS(N4))    &kp LG(LS(N5))  &kp LG(LS(N6))  &kp LG(LS(N7))  &kp LG(LS(N8))  &kp LG(LS(N9))
        &trans  &trans          &trans          &trans          &trans            &trans          &trans          &trans          &trans          &trans
&trans  &trans  &trans          &trans          &trans          &trans            &trans          &trans          &trans          &trans          &trans          &trans
                                &trans          &trans          &trans            &trans          &trans          &trans
            >;
        };

        Nav {
            bindings = <
        &trans        &kp LC(LS(TAB))  &kp LC(TAB)        &swapper         &fancyzone                &trans            &MBK_Mod1  &kp UP       &MBK_Mod2  &trans
        &kp LS(HOME)  &kp LC(SPACE)    &kp LA(LG(SPACE))  &kp LC(LS(Q))    &kp LG(UP_ARROW)          &kp LS(UP_ARROW)  &LeftHome  &kp DOWN     &RightEnd  &trans
&trans  &kp LS(END)   &kp LC(INS)      &kp LC(KP_MINUS)   &kp LC(KP_PLUS)  &kp LS(LG(LEFT_ARROW))    &kp LS(DOWN)      &TopPgup   &BottomPgdn  &HomeEnd1  &trans  &trans
                                       &trans             &trans           &trans                    &kp ENTER         &trans     &trans
            >;

            label = "Nav";
        };

        Han {
            bindings = <
        &trans  &trans  &kp LA(LS(R))  &kp LA(LS(E))  &kp LC(LS(F22))    &kp AT_SIGN        &kp ASTERISK  &kp PLUS       &kp SLASH    &kp NON_US_BACKSLASH
        &trans  &trans  &kp LA(LS(N))  &kp LA(LS(W))  &kp LC(LS(F23))    &kp UNDERSCORE     &kp MINUS     &kp SQT        &kp PERCENT  &trans
&trans  &trans  &trans  &kp LA(LS(A))  &kp LA(LS(Z))  &kp LC(LS(F24))    &kp DOUBLE_QUOTES  &kp HASH      &kp AMPERSAND  &kp CARET    &kp PIPE              &kp GRAVE
                        &trans         &hangul_table  &kp LANGUAGE_2     &kp LC(F10)        &kp LA(C)     &hangul_mail
            >;

            label = "Han";
        };

        NumHold {
            label = "NumHold";
            bindings = <
        &trans  &trans            &trans      &kp LC(L)         &trans    &kp MINUS  &kp N7  &kp N8  &kp N9  &trans
        &trans  &kp LS(LG(LEFT))  &fancyzone  &kp LG(UP_ARROW)  &trans    &kp N0     &kp N4  &kp N5  &kp N6  &trans
&trans  &trans  &trans            &kp MINUS   &trans            &trans    &kp EQUAL  &kp N1  &kp N2  &kp N3  &trans  &trans
                                  &trans      &trans            &trans    &trans     &trans  &trans
            >;
        };
    };
};
