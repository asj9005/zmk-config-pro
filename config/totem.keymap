        bs_del2: bs_del2 {
            compatible = "zmk,behavior-mod-morph";
            label = "BS_DEL2";
            bindings = <&kp LC(BACKSPACE)>, <&kp LC(DELETE)>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT)>;
        };

        bs_del3: bs_del3 {
            compatible = "zmk,behavior-hold-tap";
            label = "BS_DEL3";
            bindings = <&bs_del2>, <&bs_del1>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
        };

        Jum: Jum {
            compatible = "zmk,behavior-mod-morph";
            label = "JUM";
            bindings = <&kp PERIOD>, <&kp EXCLAMATION>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT|MOD_LSFT)>;
