//                                                         ▀▀▀   █   ▀▀▀   █   ▀▀▀   ▀   ▀▀▀
//                                                               █      ▄▄▄█▄▄▄    █   █  
//                                                               ▀      █  █  █     █▄█
//                                                             ▀▀▀▀▀    █  █  █      ▀
//                                                                      ▀  ▀  ▀
//
// ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define Base        0
#define Nav         1
#define Sym         2
#define Fun         3
#define Game        4
#define Gameplus    5

&mt {
    quick-tap-ms = <100>;
    global-quick-tap;
    flavor = "tap-preferred";
    tapping-term-ms = <170>;
};

&lt {
    tapping-term-ms = <240>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <125>;
            global-quick-tap;
            bindings = <&kp>, <&kp>;
        };

        tapdance: tapdance {
            compatible = "zmk,behavior-tap-dance";
            label = "TAPDANCE";
            #binding-cells = <0>;
            bindings = <&mo 6>, <&kmswitch>;
        };

        holdtap: holdtap {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLDTAP";
            bindings = <&lang_temp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
        };

        jum2: jum2 {
            compatible = "zmk,behavior-mod-morph";
            label = "JUM2";
            bindings = <&kp PERIOD>, <&kp COMMA>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        question: question {
            compatible = "zmk,behavior-mod-morph";
            label = "QUESTION";
            bindings = <&kp EXCLAMATION>, <&kp QUESTION>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        shiftsk: shiftsk {
            compatible = "zmk,behavior-sticky-key";
            label = "SHIFTSK";
            bindings = <&kp>;
            #binding-cells = <1>;
            release-after-ms = <1000>;
            quick-release;
        };

        shiftmodmorph: shiftmodmorph {
            compatible = "zmk,behavior-mod-morph";
            label = "SHIFTMODMORPH";
            bindings = <&shiftsk LEFT_SHIFT>, <&caps_word>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        shiftht: shiftht {
            compatible = "zmk,behavior-hold-tap";
            label = "SHIFTHT";
            bindings = <&kp>, <&shiftmodmorph>;

            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
        };

        numsym: numsym {
            compatible = "zmk,behavior-mod-morph";
            label = "NUMSYM";
            bindings = <&mo 4>, <&mo 4>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        numsym2: numsym2 {
            compatible = "zmk,behavior-hold-tap";
            label = "NUMSYM2";
            bindings = <&numsym>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <180>;
            flavor = "tap-preferred";
        };

        mousealttab: mousealttab {
            compatible = "zmk,behavior-mod-morph";
            label = "MOUSEALTTAB";
            bindings = <&to 0>, <&kp TAB>;

            #binding-cells = <0>;
            mods = <(MOD_LALT)>;
            keep-mods = <(MOD_LALT)>;
        };

        bracketmod: bracketmod {
            compatible = "zmk,behavior-mod-morph";
            label = "BRACKETMOD";
            bindings = <&bracket>, <&bracket2>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_ctrl_x {
            bindings = <&kp LC(X)>;
            key-positions = <21 22>;
        };

        combo_ctrl_c {
            bindings = <&kp LC(C)>;
            key-positions = <22 23>;
        };

        combo_ctrl_v {
            bindings = <&kp LC(V)>;
            key-positions = <23 24>;
        };

        delete {
            bindings = <&kp BACKSPACE>;
            key-positions = <6 7>;
        };

        backspace {
            bindings = <&kp DELETE>;
            key-positions = <7 8>;
        };

        altf4 {
            bindings = <&kp LA(F4)>;
            key-positions = <0 34>;
        };

        hangul {
            bindings = <&kp LANG_HANGEUL>;
            key-positions = <17 16>;
        };

        end {
            bindings = <&kp ESCAPE>;
            key-positions = <1 2 3>;
        };

        mousehold {
            bindings = <&tog 1>;
            key-positions = <2 3>;
            layers = <1 0>;
        };

        bracketcombo {
            bindings = <&bracketmod>;
            key-positions = <27 28>;
        };
    };

    macros {
        new_macro: new_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap>,
                <&kp EXCL &kp T &kp J &kp D &kp W &kp N &kp S &kp N9 &kp N0 &kp N0 &kp N5>;

            label = "NEW_MACRO";
        };

        kmswitch: kmswitch {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap>,
                <&kp CAPS &kp SCROLLLOCK &kp KP_NUMLOCK>,
                <&macro_wait_time 80>,
                <&macro_tap>,
                <&kp CAPSLOCK &kp SCROLLLOCK &kp KP_NUMLOCK>;

            label = "kmswitch";
        };

        fancyzone: lang_toggle {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_GUI>,
                <&macro_wait_time 20>,
                <&macro_tap>,
                <&kp LEFT_ARROW>,
                <&macro_wait_time 20>,
                <&macro_release>,
                <&kp LEFT_GUI>;

            label = "LANG_TOGGLE";
        };

        lang_temp: lang_temp {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap>,
                <&kp LANGUAGE_1>,
                <&macro_pause_for_release>,
                <&macro_tap>,
                <&kp LANGUAGE_1>;

            label = "LANG_TEMP";
        };

        bracket: bracket {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap>,
                <&kp LEFT_PARENTHESIS &kp RIGHT_PARENTHESIS &kp LEFT_ARROW>;

            label = "BRACKET";
        };

        bracket2: bracket2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap>,
                <&kp LEFT_BRACKET &kp RIGHT_BRACKET &kp LEFT>;

            label = "BRACKET2";
        };

        automouse: automouse {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&trans &to 0>;

            label = "automouse";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Base {
            display-name = "Base";
            bindings = <
       &kp Q        &kp W       &kp E        &kp R         &kp T           &kp Y             &kp U                  &kp I               &kp O           &kp SEMICOLON
       &hm LGUI A   &hm LALT S  &hm LCTRL D  &hm LSHIFT F  &holdtap 0 G    &holdtap 0 H      &hm RSHFT J            &hm LEFT_CONTROL K  &hm LEFT_ALT L  &hm LEFT_GUI P
&sl 6  &key_repeat  &kp Z       &kp X        &kp C         &kp V           &kp B             &kp N                  &kp M               &jum2           &question       &kp LC(LS(LA(LG(Z))))
                                &sl 8        &lt 3 SPACE   &lt 1 TAB       &numsym2 0 ENTER  &shiftht LEFT_SHIFT 0  &lt 5 LC(M)
            >;
        };

        Mouse {
            display-name = "Mouse";
            bindings = <
        &automouse       &automouse  &automouse  &automouse  &fancyzone                &trans          &mkp MB4        &mmv MOVE_UP    &mkp MB5         &trans
        &kp PRINTSCREEN  &trans      &trans      &trans      &kp LG(UP_ARROW)          &msc SCRL_LEFT  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &msc SCRL_RIGHT
&trans  &trans           &trans      &trans      &trans      &kp LG(LS(LEFT_ARROW))    &trans          &msc SCRL_UP    &msc SCRL_DOWN  &mkp MB3         &new_macro       &trans
                                     &trans      &trans      &mousealttab              &mkp MB1        &mkp MB2        &mkp MB3
            >;
        };

        Nav {
            bindings = <
        &trans    &kp LC(INSERT)  &kp LC(KP_PLUS)  &kp LC(KP_MINUS)  &fancyzone                &trans     &mt LC(BACKSPACE) BACKSPACE  &kp UP_ARROW   &mt LC(DELETE) DELETE  &trans
        &kp LGUI  &kp LALT        &kp LCTRL        &kp LSHFT         &kp LG(UP_ARROW)          &kp HOME   &kp LEFT_ARROW               &kp DOWN       &kp RIGHT_ARROW        &kp END
&trans  &trans    &trans          &trans           &trans            &kp LS(LG(LEFT_ARROW))    &trans     &kp PAGE_UP                  &kp PAGE_DOWN  &trans                 &trans   &trans
                                  &trans           &trans            &trans                    &kp ENTER  &trans                       &trans
            >;

            label = "Nav";
        };

        Sym {
            bindings = <
        &kp LEFT_BRACE     &kp AMPERSAND    &kp ASTERISK          &kp TILDE              &kp RIGHT_BRACE    &trans  &trans  &trans  &trans  &trans
        &kp SQT            &kp DOLLAR       &kp PERCENT           &kp LCTRL              &kp LC(F10)        &trans  &trans  &trans  &trans  &trans
&trans  &kp DOUBLE_QUOTES  &kp EXCLAMATION  &kp AT_SIGN           &kp HASH               &kp LANGUAGE_2     &trans  &trans  &trans  &trans  &trans  &trans
                                            &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp UNDERSCORE     &trans  &trans  &trans
            >;

            label = "Sym";
        };

        Num {
            bindings = <
        &kp LBKT  &kp N7  &kp N8     &kp N9  &kp RBKT    &kp COLON  &kp TILDE  &trans        &trans     &trans
        &trans    &kp N4  &kp N5     &kp N6  &kp N0      &kp PLUS   &kp MINUS  &kp ASTERISK  &kp SLASH  &trans
&trans  &trans    &kp N1  &kp N2     &kp N3  &kp DOT     &trans     &trans     &trans        &trans     &trans  &trans
                          &kp EQUAL  &trans  &trans      &trans     &trans     &trans
            >;

            label = "Num";
        };

        Fun {
            bindings = <
        &kp F12  &kp F7  &kp F8  &kp F9  &kp LC(F10)    &trans  &trans     &trans     &trans    &trans
        &kp F11  &kp F4  &kp F5  &kp F6  &trans         &trans  &kp LSHFT  &kp LCTRL  &kp LALT  &kp LGUI
&trans  &kp F10  &kp F1  &kp F2  &kp F3  &trans         &trans  &trans     &trans     &trans    &trans    &trans
                         &trans  &trans  &trans         &trans  &trans     &trans
            >;

            label = "Fun";
        };

        Asj {
            bindings = <
        &sys_reset  &kp F23  &automouse  &trans  &studio_unlock    &trans  &trans  &trans  &trans  &trans
        &trans      &trans   &trans      &trans  &trans            &trans  &trans  &trans  &trans  &trans
&trans  &trans      &trans   &trans      &trans  &trans            &trans  &trans  &trans  &trans  &trans  &trans
                             &trans      &trans  &kmswitch         &trans  &trans  &trans
            >;
        };

        Fast {
            display-name = "Mouse";
            bindings = <
        &kp LC(LS(Q))    &trans  &automouse  &trans  &fancyzone                &trans            &mkp MB4            &mmv MOVE_Y(-3000)  &mkp MB5           &trans
        &kp PRINTSCREEN  &trans  &trans      &trans  &kp LG(UP_ARROW)          &msc MOVE_X(-50)  &mmv MOVE_X(-3000)  &mmv MOVE_Y(3000)   &mmv MOVE_X(2300)  &msc MOVE_X(50)
&trans  &trans           &trans  &trans      &trans  &kp LG(LS(LEFT_ARROW))    &trans            &msc MOVE_Y(50)     &msc MOVE_Y(-50)    &mkp MB3           &trans           &trans
                                 &trans      &trans  &trans                    &mkp MB1          &mkp MB2            &mkp MB3
            >;

            label = "Fast";
        };

        Start {
            bindings = <
        &trans  &kp LG(LS(N1))  &kp LG(LS(N2))  &kp LG(LS(N3))  &kp LG(LS(N4))    &kp LG(LS(N5))  &kp LG(LS(N6))  &kp LG(LS(N7))  &kp LG(LS(N8))  &kp LG(LS(N9))
        &trans  &trans          &trans          &trans          &trans            &trans          &trans          &trans          &trans          &trans
&trans  &trans  &trans          &trans          &trans          &trans            &trans          &trans          &trans          &trans          &trans          &trans
                                &trans          &trans          &trans            &trans          &trans          &trans
            >;
        };

        Media {
            bindings = <
        &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
        &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans  &trans
            >;
        };
    };
};
