#include <input/processors.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define Base        0
#define Mouse       1
#define Acc         2
#define Prec        3
#define Num         4
#define Fun         5
#define Asj         6
#define Start       7
#define Nav         8
#define Han         9

/* --- Mouse speed scalers (instant ACC / PREC) --- */

&mmv_input_listener {
    /* default 1x */

    input-processors = <&zip_xy_scaler 2 1>;

    fast {
        layers = <Acc>;
        input-processors = <&zip_xy_scaler 5 1>; /* 3x speed */
    };

    slow {
        layers = <Prec>;
        input-processors = <&zip_xy_scaler 1 3>; /* 1/3x speed */
    };
};

&msc_input_listener {
    input-processors = <&zip_scroll_scaler 1 1>;

    fast {
        layers = <Acc>;
        input-processors = <&zip_scroll_scaler 3 1>;
    };

    slow {
        layers = <Prec>;
        input-processors = <&zip_scroll_scaler 1 3>;
    };
};

&mt {
    quick-tap-ms = <100>;
    global-quick-tap;
    flavor = "tap-preferred";
    tapping-term-ms = <170>;
};

&lt {
    tapping-term-ms = <240>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <125>;
            global-quick-tap;
            bindings = <&sk>, <&kp>;
        };

        tapdance: tapdance {
            compatible = "zmk,behavior-tap-dance";
            label = "TAPDANCE";
            #binding-cells = <0>;
            bindings = <&mo 6>, <&kmswitch>;
        };

        Colon1: Colon1 {
            compatible = "zmk,behavior-mod-morph";
            label = "COLON1";
            bindings = <&kp COLON>, <&kp SEMI>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT|MOD_LSFT)>;
        };

        shiftsk: shiftsk {
            compatible = "zmk,behavior-sticky-key";
            label = "SHIFTSK";
            bindings = <&kp>;
            #binding-cells = <1>;
            release-after-ms = <1000>;
            quick-release;
            ignore-modifiers;
        };

        bracketmod: bracketmod {
            compatible = "zmk,behavior-mod-morph";
            label = "BRACKETMOD";
            bindings = <&bracket>, <&bracket2>;

