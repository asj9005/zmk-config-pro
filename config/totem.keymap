        Alt_Combo: Alt_Combo {
            compatible = "zmk,behavior-hold-tap";
            label = "ALT_COMBO";
            bindings = <&kp>, <&Skcb_Alt>;

            #binding-cells = <2>;
            tapping-term-ms = <180>;
            flavor = "tap-preferred";
        };

        Ctrl_Combo: Ctrl_Combo {
            compatible = "zmk,behavior-hold-tap";
            label = "CTRL_COMBO";
            bindings = <&kp>, <&Skcb_Ctrl>;

            #binding-cells = <2>;
