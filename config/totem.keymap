//                                                        █   █  █  █   █  █  █   █  █  █   █
//                                                         ▀▀▀   █   ▀▀▀   █   ▀▀▀   ▀   ▀▀▀
//                                                               █      ▄▄▄█▄▄▄    █   █  
//                                                               ▀      █  █  █     █▄█
//                                                             ▀▀▀▀▀    █  █  █      ▀
//                                                                      ▀  ▀  ▀
//
// ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define Base        0
#define Nav         1
#define Sym         2
#define Fun         3
#define Game        4
#define Gameplus    5

&mt {
    quick-tap-ms = <100>;
    global-quick-tap;
    flavor = "tap-preferred";
    tapping-term-ms = <170>;
};

&lt {
    tapping-term-ms = <240>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <125>;
            global-quick-tap;
            bindings = <&kp>, <&kp>;
        };

        tapdance: tapdance {
            compatible = "zmk,behavior-tap-dance";
            label = "TAPDANCE";
            #binding-cells = <0>;
            bindings = <&mo 4>, <&kmswitch>;
        };

        holdtap: holdtap {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLDTAP";
            bindings = <&lang_temp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
        };

        jum2: jum2 {
            compatible = "zmk,behavior-mod-morph";
            label = "JUM2";
            bindings = <&kp PERIOD>, <&kp COMMA>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        question: question {
            compatible = "zmk,behavior-mod-morph";
            label = "QUESTION";
            bindings = <&kp EXCLAMATION>, <&kp QUESTION>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        shiftsk: shiftsk {
            compatible = "zmk,behavior-sticky-key";
            label = "SHIFTSK";
            bindings = <&kp>;
            #binding-cells = <1>;
            release-after-ms = <1000>;
            quick-release;
        };

        shiftmodmorph: shiftmodmorph {
            compatible = "zmk,behavior-mod-morph";
            label = "SHIFTMODMORPH";
            bindings = <&shiftsk LEFT_SHIFT>, <&caps_word>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        shiftht: shiftht {
            compatible = "zmk,behavior-hold-tap";
            label = "SHIFTHT";
            bindings = <&kp>, <&shiftmodmorph>;

            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
        };

        mousealttab: mousealttab {
            compatible = "zmk,behavior-mod-morph";
            label = "MOUSEALTTAB";
            bindings = <&to 0>, <&kp TAB>;

            #binding-cells = <0>;
            mods = <(MOD_LALT)>;
            keep-mods = <(MOD_LALT)>;
        };

        bracketmod: bracketmod {
            compatible = "zmk,behavior-mod-morph";
            label = "BRACKETMOD";
            bindings = <&bracket>, <&bracket2>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        atlayerhmbe: atlayerhmbe {
            compatible = "zmk,behavior-hold-tap";
            label = "ATLAYERHMBE";
            bindings = <&atlayerhm>, <&atlayertab>;

            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <180>;
        };

        atlayerspeed: atlayerspeed {
            compatible = "zmk,behavior-hold-tap";
            label = "ATLAYERSPEED";
            bindings = <&mo>, <&atlayertab>;

            #binding-cells = <2>;
            tapping-term-ms = <180>;
            flavor = "tap-preferred";
        };

        atlayerdo: atlayerdo {
            compatible = "zmk,behavior-hold-tap";
            label = "ATLAYERDO";
            bindings = <&fancyzone>, <&atlayertab>;

            #binding-cells = <2>;
            tapping-term-ms = <180>;
            flavor = "tap-preferred";
        };

        atlayerdo2: atlayerdo2 {
            compatible = "zmk,behavior-hold-tap";
            label = "ATLAYERDO2";
            bindings = <&kp>, <&atlayertab>;

            #binding-cells = <2>;
            tapping-term-ms = <180>;
            flavor = "tap-preferred";
        };

        numsymtog: numsymtog {
            compatible = "zmk,behavior-mod-morph";
            label = "NUMSYMTOG";
            bindings = <&to 2>, <&to 0>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        numsymtog2: numsymtog2 {
            compatible = "zmk,behavior-mod-morph";
            label = "NUMSYMTOG2";
            bindings = <&mo 2>, <&mo 0>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        numsymbtn: numsymbtn {
            compatible = "zmk,behavior-hold-tap";
            label = "NUMSYMBTN";
            bindings = <&numsymtog2>, <&numsymtog>;

            #binding-cells = <2>;
            tapping-term-ms = <180>;
            flavor = "tap-preferred";
        };

        nummmm: nummmm {
            compatible = "zmk,behavior-hold-tap";
            label = "NUMMMM";
            bindings = <&mo>, <&to>;

            #binding-cells = <2>;
            tapping-term-ms = <180>;
            flavor = "tap-preferred";
        };

        deletemodmorph: deletemodmorph {
            compatible = "zmk,behavior-mod-morph";
            label = "DELETEMODMORPH";
            bindings = <&kp BACKSPACE>, <&kp DELETE>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        mousealt: mousealt {
            compatible = "zmk,behavior-hold-tap";
            label = "MOUSEALT";
            bindings = <&lt>, <&deletemod>;

            #binding-cells = <2>;
            tapping-term-ms = <180>;
            flavor = "tap-preferred";
        };

        deletemod: deletemod {
            compatible = "zmk,behavior-mod-morph";
            label = "DELETEMOD";
            bindings = <&kp BACKSPACE>, <&kp DELETE>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        timemod: timemod {
            compatible = "zmk,behavior-mod-morph";
            label = "TIMEMOD";
            bindings = <&kp TILDE>, <&kp COLON>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        tomolayer: tomolayer {
            compatible = "zmk,behavior-hold-tap";
            label = "TOMOLAYER";
            bindings = <&mo>, <&to>;

            #binding-cells = <2>;
            tapping-term-ms = <180>;
            flavor = "tap-preferred";
        };

        togmolayer: togmolayer {
            compatible = "zmk,behavior-hold-tap";
            label = "TOGMOLAYER";
            bindings = <&mo>, <&tog>;

            #binding-cells = <2>;
            tapping-term-ms = <180>;
            flavor = "tap-preferred";
        };

        shiftdance: shiftdance {
            compatible = "zmk,behavior-tap-dance";
            label = "SHIFTDANCE";
            #binding-cells = <0>;
            bindings = <&sk LEFT_SHIFT>, <&kp LC(LS(LA(LG(M))))>;
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_ctrl_x {
            bindings = <&kp LC(X)>;
            key-positions = <21 22>;
        };

        combo_ctrl_c {
            bindings = <&kp LC(C)>;
            key-positions = <22 23>;
        };

        combo_ctrl_v {
            bindings = <&kp LC(V)>;
            key-positions = <23 24>;
        };

        delete {
            bindings = <&kp BACKSPACE>;
            key-positions = <6 7>;
        };

        backspace {
            bindings = <&kp DELETE>;
            key-positions = <7 8>;
        };

        altf4 {
            bindings = <&kp LA(F4)>;
            key-positions = <0 34>;
        };

        hangul {
            bindings = <&kp LANG_HANGEUL>;
            key-positions = <17 16>;
        };

        end {
            bindings = <&esccombo>;
            key-positions = <1 2 3>;
        };

        mousehold {
            bindings = <&tog 1>;
            key-positions = <2 3>;
        };

        bracketcombo {
            bindings = <&bracketmod>;
            key-positions = <27 28>;
        };

        tab {
            bindings = <&kp TAB>;
            key-positions = <12 13>;
        };

        layerexit {
            bindings = <&to 0>;
            key-positions = <2 1>;
        };

        fluent {
            bindings = <&kp LC(M)>;
            key-positions = <17 18>;
        };

        enter {
            bindings = <&kp ENTER>;
            key-positions = <12 11>;
        };

        shiftcom2 {
            bindings = <&sk LEFT_SHIFT>;
            key-positions = <29 28>;
        };
    };

    macros {
        new_macro: new_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap>,
                <&kp EXCL &kp T &kp J &kp D &kp W &kp N &kp S &kp N9 &kp N0 &kp N0 &kp N5>;

            label = "NEW_MACRO";
        };

        kmswitch: kmswitch {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap>,
                <&kp CAPS &kp SCROLLLOCK &kp KP_NUMLOCK>,
                <&macro_wait_time 80>,
                <&macro_tap>,
                <&kp CAPSLOCK &kp SCROLLLOCK &kp KP_NUMLOCK>;

            label = "kmswitch";
        };

        fancyzone: lang_toggle {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_GUI>,
                <&macro_wait_time 20>,
                <&macro_tap>,
                <&kp LEFT_ARROW>,
                <&macro_wait_time 20>,
                <&macro_release>,
                <&kp LEFT_GUI>;

            label = "LANG_TOGGLE";
        };

        lang_temp: lang_temp {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap>,
                <&kp LANGUAGE_1>,
                <&macro_pause_for_release>,
                <&macro_tap>,
                <&kp LANGUAGE_1>;

            label = "LANG_TEMP";
        };

        bracket: bracket {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap>,
                <&kp LEFT_PARENTHESIS &kp RIGHT_PARENTHESIS &kp LEFT_ARROW>;

            label = "BRACKET";
        };

        bracket2: bracket2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap>,
                <&kp LEFT_BRACKET &kp RIGHT_BRACKET &kp LEFT>;

            label = "BRACKET2";
        };

        atlayertab: atlayertab {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_tap>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER &to 0>;

            label = "atlayertab";
            wait-ms = <0>;
            tap-ms = <0>;
        };

        atlayerhm: atlayerhm {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_press>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_tap>,
                <&to 0>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>;

            label = "atlayerhm";
            wait-ms = <0>;
            tap-ms = <0>;
        };

        alttab: alttab {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT &kp TAB>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp TAB>;

            label = "ALTTAB";
            wait-ms = <0>;
            tap-ms = <0>;
        };

        esccombo: esccombo {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&to 0 &kp ESCAPE>;

            label = "ESCCOMBO";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Base {
            display-name = "Base";
            bindings = <
       &kp SINGLE_QUOTE  &lt 2 W     &kp E        &kp R           &kp T             &kp Y                  &kp U        &kp I               &kp O           &kp SEMICOLON
       &hm LGUI A        &hm LALT S  &hm LCTRL D  &hm LSHIFT F    &holdtap 0 G      &holdtap 0 H           &hm RSHFT J  &hm LEFT_CONTROL K  &hm LEFT_ALT L  &hm LEFT_GUI P
&sl 4  &kp Z             &kp X       &kp C        &kp V           &kp Q             &kp B                  &kp N        &kp M               &jum2           &question       &shiftdance
                                     &sl 6        &tomolayer 7 2  &tomolayer 8 1    &shiftht LEFT_SHIFT 0  &kp SPACE    &lt 3 LC(M)
            >;
        };

        Mouse {
            display-name = "Mouse";
            bindings = <
        &atlayertab SQT          &atlayertab W            &atlayerspeed 5 E     &atlayertab R          &atlayerdo T T                &trans          &mkp MB4        &mmv MOVE_UP    &mkp MB5         &trans
        &atlayerhmbe LEFT_GUI A  &atlayerhmbe LEFT_ALT S  &atlayerhmbe LCTRL D  &atlayerhmbe LSHIFT F  &atlayerdo2 LG(UP_ARROW) G    &msc SCRL_LEFT  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &msc SCRL_RIGHT
&trans  &atlayertab Z            &atlayertab X            &atlayertab C         &atlayertab V          &atlayerdo2 LS(LG(LEFT)) Q    &trans          &msc SCRL_UP    &msc SCRL_DOWN  &mkp MB3         &new_macro       &trans
                                                          &trans                &trans                 &tomolayer 8 0                &mkp MB1        &mkp MB2        &kp LC(M)
            >;
        };

        Num {
            bindings = <
        &atlayertab SQT          &atlayertab W            &atlayertab E         &atlayertab R              &atlayertab T    &kp MINUS  &kp N7  &kp N8  &kp N9  &timemod
        &atlayerhmbe LEFT_GUI A  &atlayerhmbe LEFT_ALT S  &atlayerhmbe LCTRL D  &atlayerhmbe LEFT_SHIFT F  &atlayertab G    &kp N0     &kp N4  &kp N5  &kp N6  &kp EQUAL
&trans  &atlayertab Z            &atlayertab X            &atlayertab C         &atlayertab V              &atlayertab Q    &jum2      &kp N1  &kp N2  &kp N3  &kp SLASH  &trans
                                                          &trans                &tomolayer 7 0             &trans           &trans     &trans  &trans
            >;

            label = "Num";
        };

        Fun {
            bindings = <
        &kp F12  &kp F7  &kp F8  &kp F9  &kp LC(F10)       &trans  &trans     &trans     &trans    &trans
        &kp F11  &kp F4  &kp F5  &kp F6  &trans            &trans  &kp LSHFT  &kp LCTRL  &kp LALT  &kp LGUI
&trans  &kp F10  &kp F1  &kp F2  &kp F3  &kp LANGUAGE_2    &trans  &trans     &trans     &trans    &trans    &trans
                         &trans  &trans  &trans            &trans  &trans     &trans
            >;

            label = "Fun";
        };

        Asj {
            bindings = <
        &sys_reset  &kp F23  &kp F24  &trans  &studio_unlock    &trans  &trans  &trans  &trans  &trans
        &trans      &trans   &trans   &trans  &trans            &trans  &trans  &trans  &trans  &trans
&trans  &trans      &trans   &trans   &trans  &trans            &trans  &trans  &trans  &trans  &trans  &trans
                             &trans   &trans  &kmswitch         &trans  &trans  &trans
            >;
        };

        Fast {
            display-name = "Mouse";
            bindings = <
        &kp LC(LS(Q))    &trans  &trans  &trans  &fancyzone                &trans            &mkp MB4            &mmv MOVE_Y(-3000)  &mkp MB5           &trans
        &kp PRINTSCREEN  &trans  &trans  &trans  &kp LG(UP_ARROW)          &msc MOVE_X(-50)  &mmv MOVE_X(-3000)  &mmv MOVE_Y(3000)   &mmv MOVE_X(2300)  &msc MOVE_X(50)
&trans  &trans           &trans  &trans  &trans  &kp LG(LS(LEFT_ARROW))    &trans            &msc MOVE_Y(50)     &msc MOVE_Y(-50)    &mkp MB3           &trans           &trans
                                 &trans  &trans  &trans                    &mkp MB1          &mkp MB2            &mkp MB3
            >;

            label = "Fast";
        };

        Start {
            bindings = <
        &trans  &kp LG(LS(N1))  &kp LG(LS(N2))  &kp LG(LS(N3))  &kp LG(LS(N4))    &kp LG(LS(N5))  &kp LG(LS(N6))  &kp LG(LS(N7))  &kp LG(LS(N8))  &kp LG(LS(N9))
        &trans  &trans          &trans          &trans          &trans            &trans          &trans          &trans          &trans          &trans
&trans  &trans  &trans          &trans          &trans          &trans            &trans          &trans          &trans          &trans          &trans          &trans
                                &trans          &trans          &trans            &trans          &trans          &trans
            >;
        };

        Nav {
            bindings = <
        &kp LC(INS)  &kp LC(MINUS)  &kp LC(KP_PLUS)  &alttab    &fancyzone                &trans     &mt LC(BACKSPACE) BACKSPACE  &kp UP_ARROW   &mt LC(DELETE) DELETE  &trans
        &kp LGUI     &kp LALT       &kp LCTRL        &kp LSHFT  &kp LG(UP_ARROW)          &kp HOME   &kp LEFT_ARROW               &kp DOWN       &kp RIGHT_ARROW        &kp END
&trans  &trans       &trans         &trans           &trans     &kp LS(LG(LEFT_ARROW))    &kp LC(Z)  &kp PAGE_UP                  &kp PAGE_DOWN  &trans                 &trans   &trans
                                    &trans           &trans     &trans                    &kp ENTER  &trans                       &trans
            >;

            label = "Nav";
        };

        mshold {
            bindings = <
        &kp LC(LS(Q))    &trans  &mo 5            &kp LA(TAB)  &fancyzone          &trans          &mkp MB4        &mmv MOVE_UP    &mkp MB5         &trans
        &kp PRINTSCREEN  &trans  &kp LC(LS(TAB))  &kp LC(TAB)  &kp LG(UP_ARROW)    &msc SCRL_LEFT  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &msc SCRL_RIGHT
&trans  &trans           &trans  &trans           &trans       &kp LG(LS(LEFT))    &kp LC(Z)       &msc SCRL_UP    &msc SCRL_DOWN  &mkp MB3         &new_macro       &trans
                                 &trans           &trans       &trans              &mkp MB1        &mkp MB2        &trans
            >;

            label = "mshold";
        };
    };
};
