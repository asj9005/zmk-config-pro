#include <input/processors.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define Base        0
#define Mouse       1
#define Acc         2
#define Prec        3
#define Num         4
#define Fun         5
#define Asj         6
#define Start       7
#define Nav         8
#define Han         9

/* --- Mouse speed scalers (instant ACC / PREC) --- */

&mmv_input_listener {
    /* default 1x */

    input-processors = <&zip_xy_scaler 2 1>;

    fast {
        layers = <Acc>;
        input-processors = <&zip_xy_scaler 5 1>; /* 3x speed */
    };

    slow {
        layers = <Prec>;
        input-processors = <&zip_xy_scaler 1 3>; /* 1/3x speed */
    };
};

&msc_input_listener {
    input-processors = <&zip_scroll_scaler 1 1>;

    fast {
        layers = <Acc>;
        input-processors = <&zip_scroll_scaler 3 1>;
    };

    slow {
        layers = <Prec>;
        input-processors = <&zip_scroll_scaler 1 3>;
    };
};

&mt {
    quick-tap-ms = <100>;
    global-quick-tap;
    flavor = "tap-preferred";
    tapping-term-ms = <170>;
};

&lt {
    tapping-term-ms = <240>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

&sk { quick-release; };

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <125>;
            global-quick-tap;
            bindings = <&sk>, <&kp>;
        };

        tapdance: tapdance {
            compatible = "zmk,behavior-tap-dance";
            label = "TAPDANCE";
            #binding-cells = <0>;
            bindings = <&mo 6>, <&kmswitch>;
        };

        Colon1: Colon1 {
            compatible = "zmk,behavior-mod-morph";
            label = "COLON1";
            bindings = <&kp COLON>, <&kp SEMI>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT|MOD_LSFT)>;
        };

        shiftsk: shiftsk {
            compatible = "zmk,behavior-sticky-key";
            label = "SHIFTSK";
            bindings = <&kp>;
            #binding-cells = <1>;
            release-after-ms = <1000>;
            quick-release;
            ignore-modifiers;
        };

        bracketmod: bracketmod {
            compatible = "zmk,behavior-mod-morph";
            label = "BRACKETMOD";
            bindings = <&bracket>, <&bracket2>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT)>;
        };

        atlayerhmbe: atlayerhmbe {
            compatible = "zmk,behavior-hold-tap";
            label = "ATLAYERHMBE";
            bindings = <&atlayerhm>, <&atlayertab>;

            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <180>;
        };

        atlayerspeed: atlayerspeed {
            compatible = "zmk,behavior-hold-tap";
            label = "ATLAYERSPEED";
            bindings = <&mo>, <&atlayertab>;

            #binding-cells = <2>;
            tapping-term-ms = <180>;
            flavor = "tap-preferred";
        };

        numsymtog: numsymtog {
            compatible = "zmk,behavior-mod-morph";
            label = "NUMSYMTOG";
            bindings = <&to 5>, <&to 0>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT)>;
        };

        numsymtog2: numsymtog2 {
            compatible = "zmk,behavior-mod-morph";
            label = "NUMSYMTOG2";
            bindings = <&mo 5>, <&mo 0>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT)>;
        };

        numsymbtn: numsymbtn {
            compatible = "zmk,behavior-hold-tap";
            label = "NUMSYMBTN";
            bindings = <&numsymtog2>, <&numsymtog>;

            #binding-cells = <2>;
            tapping-term-ms = <180>;
            flavor = "tap-preferred";
        };

        nummmm: nummmm {
            compatible = "zmk,behavior-hold-tap";
            label = "NUMMMM";
            bindings = <&mo>, <&to>;

            #binding-cells = <2>;
            tapping-term-ms = <180>;
            flavor = "tap-preferred";
        };

        timemod: timemod {
            compatible = "zmk,behavior-mod-morph";
            label = "TIMEMOD";
            bindings = <&kp TILDE>, <&kp COLON>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT|MOD_LSFT)>;
        };

        tomolayer: tomolayer {
            compatible = "zmk,behavior-hold-tap";
            label = "TOMOLAYER";
            bindings = <&mo>, <&to>;

            #binding-cells = <2>;
